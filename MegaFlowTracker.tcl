addUserKnob {22 add_point l "Add Point" -STARTLINE T "import nuke\n\ndef _count(node):\n    i = 1\n    while (\"point%d\" % i) in node.knobs():\n        i += 1\n    return i - 1\n\ndef _xy(k):\n    try:\n        return \[float(k.value(0)), float(k.value(1))]\n    except Exception:\n        v = k.value()\n        return \[float(v\[0]), float(v\[1])]\n\ndef _is_content(k):\n    # everything we manage EXCEPT the tab.\n    # \"points\" stays so a stale manual knob still gets purged.\n    nm = k.name()\n    if isinstance(k, nuke.Tab_Knob):\n        return False\n    if isinstance(k, (nuke.Text_Knob, nuke.PyScript_Knob,\n                      nuke.XY_Knob, nuke.Enumeration_Knob)):\n        return True\n    if nm in (\"npz\", \"points\"):\n        return True\n    if nm.startswith(\"no_anchor\"):\n        return True\n    if nm.startswith(\"point\") and nm\[5:].isdigit():\n        return True\n    if nm.startswith(\"enable\") and nm\[6:].isdigit():\n        return True\n    return False\n\ndef _user_tabs(node):\n    return \[k for k in node.knobs().values()\n            if isinstance(k, nuke.Tab_Knob) and k.name().startswith(\"User\")]\n\ndef rebuild(node, n_points):\n    kn = node.knobs()\n\n    npz       = node\[\"npz\"].value()          if \"npz\" in kn          else \"\"\n    fmt       = node\[\"format\"].value()       if \"format\" in kn       else \"both\"\n    no_anchor = bool(node\[\"no_anchor\"].value()) if \"no_anchor\" in kn else False\n    track_cmd = node\[\"trackit\"].value()      if \"trackit\" in kn      else \"\"\n    add_cmd   = node\[\"add_point\"].value()    if \"add_point\" in kn    else \"\"\n    rem_cmd   = node\[\"remove_point\"].value() if \"remove_point\" in kn else \"\"\n\n    old = \[]\n    i = 1\n    while (\"point%d\" % i) in kn:\n        en = \"enable%d\" % i\n        old.append((_xy(node\[\"point%d\" % i]),\n                    bool(node\[en].value()) if en in kn else True))\n        i += 1\n\n    # strip content (skip un-removable)\n    for k in list(node.knobs().values()):\n        if _is_content(k):\n            try:\n                node.removeKnob(k)\n            except Exception:\n                pass\n\n    # keep exactly one user tab; never blindly re-add it\n    tabs = _user_tabs(node)\n    for t in tabs\[1:]:\n        try:\n            node.removeKnob(t)\n        except Exception:\n            pass\n    if not _user_tabs(node):\n        node.addKnob(nuke.Tab_Knob(\"User\", \"MEGAFlowTracker_PM\"))\n\n    n_points = max(1, int(n_points))\n    try:\n        rf = node.format()\n    except Exception:\n        rf = nuke.root().format()\n    cx, cy = rf.width() / 2.0, rf.height() / 2.0\n\n    f = nuke.File_Knob(\"npz\", \"NPZ FILE\")\n    f.setValue(npz)\n    node.addKnob(f)\n    node.addKnob(nuke.Text_Knob(\"div_a\", \"\"))\n\n    for j in range(n_points):\n        if j < len(old):\n            (vx, vy), on = old\[j]\n        else:\n            vx = cx + (j % 2) * 80 - 40\n            vy = cy + (j // 2) * 80 - 40\n            on = True\n        xy = nuke.XY_Knob(\"point%d\" % (j + 1), \"point%d\" % (j + 1))\n        xy.setValue(\[vx, vy])\n        xy.setTooltip(\"NUKE coords (y-up). Drag the handle in the Viewer.\")\n        node.addKnob(xy)\n        eb = nuke.Boolean_Knob(\"enable%d\" % (j + 1), \"enable\")\n        eb.clearFlag(nuke.STARTLINE)\n        eb.setValue(on)\n        node.addKnob(eb)\n\n    node.addKnob(nuke.Text_Knob(\"div_b\", \"\"))\n\n    ap = nuke.PyScript_Knob(\"add_point\", \"Add Point\", add_cmd)\n    node.addKnob(ap)\n    rp = nuke.PyScript_Knob(\"remove_point\", \"Remove Point\", rem_cmd)\n    rp.clearFlag(nuke.STARTLINE)\n    node.addKnob(rp)\n\n    node.addKnob(nuke.Text_Knob(\"div_c\", \"\"))\n\n    fk = nuke.Enumeration_Knob(\"format\", \"Export\",\n                               \[\"tracker4\", \"cornerpin\", \"both\"])\n    fk.setValue(fmt)\n    node.addKnob(fk)\n    na = nuke.Boolean_Knob(\"no_anchor\", \"no anchor\")\n    na.clearFlag(nuke.STARTLINE)\n    na.setFlag(nuke.INVISIBLE)\n    na.setValue(no_anchor)\n    node.addKnob(na)\n    tk = nuke.PyScript_Knob(\"trackit\", \"TRACK IT\", track_cmd)\n    tk.clearFlag(nuke.STARTLINE)\n    node.addKnob(tk)\n\n    node.addKnob(nuke.Text_Knob(\"div_d\", \"\"))\n    node.addKnob(nuke.Text_Knob(\"credit\", \"\",\n                                \"MEGAFlowTracker_PM by Peter Mercell 2026\"))\n\n_n = nuke.thisNode()\nrebuild(_n, _count(_n) + 1)"}
